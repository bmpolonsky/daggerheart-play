{
  "name": "daggerheart-play",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/cache-daggerheart-data.mjs",
    "build": "tsc -b && vite build",
    "prebuild": "node scripts/cache-daggerheart-data.mjs",
    "postbuild": "cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test:unit": "vitest run tests/unit/*.test.ts",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@3d-dice/dice-box-threejs": "0.0.12",
    "@preact/preset-vite": "2.10.2",
    "@sentry/browser": "10.55.0",
    "@trystero-p2p/mqtt": "0.24.0",
    "@trystero-p2p/torrent": "0.24.0",
    "dexie": "4.4.2",
    "html-to-image": "1.11.11",
    "lucide-react": "latest",
    "preact": "10.29.2",
    "three": "0.184.0",
    "trystero": "0.24.0",
    "typescript": "latest",
    "vite": "7.3.3"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@tailwindcss/vite": "4.3.0",
    "@types/node": "22.18.13",
    "@types/react": "latest",
    "@types/three": "0.184.1",
    "sharp": "0.34.5",
    "tailwindcss": "4.3.0",
    "vitest": "4.1.7"
  }
}
